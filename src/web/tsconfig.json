{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["vite/client"],
		"paths": {
			"@/*": ["./*"]
		}
	},
	"include": ["./**/*.ts", "./**/*.tsx"]
}
