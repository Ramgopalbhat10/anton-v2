# LLM — OpenRouter is the product gateway. Anthropic is optional for local flue run.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# GitHub OAuth (leave empty to use the local unauthenticated dev project)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:43127/api/auth/github/callback

# Turso / libSQL. Default is a local file database.
TURSO_DATABASE_URL=file:./data/anton.db
TURSO_AUTH_TOKEN=

# Modal sandbox (leave empty to use a local workspace directory)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Tigris S3 (optional; logs / memory / artifacts only)
TIGRIS_ENDPOINT=
TIGRIS_BUCKET=
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=

# App
SESSION_SECRET=dev-session-secret-change-me
TOKEN_ENCRYPTION_KEY=dev-token-key-change-me-32b
ANTON_DEV_USER=1
PORT=43127
