# Model gateway
OPENROUTER_API_KEY=

# GitHub: a fine-grained token with Contents and Pull requests read/write
ANTON_GITHUB_TOKEN=
ANTON_DEFAULT_REPO=

# Modal sandboxes (leave empty to run tasks in local folders)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Tigris or any S3 API (leave empty to keep checkpoints on disk)
TIGRIS_ENDPOINT=https://t3.storage.dev
TIGRIS_BUCKET=
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=

# Task records. Default is a local file database.
TURSO_DATABASE_URL=file:./data/anton.db
TURSO_AUTH_TOKEN=

# Kernel hosted browsers, for the Browser panel (kernel.sh; the free plan has monthly credits)
KERNEL_API_KEY=

# Optional overrides
# ANTON_SANDBOX=modal|local
# ANTON_STORE=s3|disk
# ANTON_IDLE_MINUTES=5
# ANTON_MODEL=openrouter/~deepseek/deepseek-flash-latest
# ANTON_DECISION_MODEL=~typesafe/jev-latest   (off to turn off)
# The model the computer subagent sees the sandbox's screen with, when its own and the task's cannot read images.
# ANTON_VISION_MODEL=openrouter/anthropic/claude-haiku-5.5
# Where push services can reach you about Anton's phone notifications.
# ANTON_PUSH_CONTACT=mailto:you@example.com
PORT=3000
