{
	"name": "anton-v2",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"dev": "concurrently -k -n api,ui -c blue,magenta \"npm run dev:api\" \"npm run dev:ui\"",
		"dev:api": "vite dev --host 127.0.0.1 --port 43128 --strictPort",
		"dev:ui": "vite --config vite.config.ui.ts --host 127.0.0.1 --port 43127 --strictPort",
		"build": "vite build && vite build --config vite.config.ui.ts",
		"start": "node src/server.ts",
		"start:backup": "scripts/start-with-backup.sh",
		"check:types": "tsc --noEmit && tsc --noEmit -p src/web/tsconfig.json",
		"lint:hooks": "oxlint -c .oxlintrc.json src/web",
		"test": "node --experimental-strip-types --test tests/*.test.ts",
		"test:ui": "vitest run",
		"ui:fixture": "vite --config scripts/ui/vite.config.ts",
		"anton:run": "node --experimental-strip-types scripts/anton-run.ts",
		"browser:bench": "node --experimental-strip-types scripts/browser-bench.ts",
		"tool:mix": "node --experimental-strip-types scripts/tool-mix.ts",
		"cache:misses": "node --experimental-strip-types scripts/cache-misses.ts",
		"gates:report": "node --experimental-strip-types scripts/gates-report.ts",
		"postinstall": "node --experimental-strip-types scripts/patch-flue.ts"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.296",
		"@cursor/sdk": "^1.0.37",
		"@earendil-works/pi-ai": "^0.83.0",
		"@earendil-works/pi-codemode": "^1.0.2",
		"@flue/react": "^2.0.7",
		"@flue/runtime": "^2.0.7",
		"@flue/sdk": "^2.0.7",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@hono/node-server": "^1.19.0",
		"@libsql/client": "^0.15.9",
		"@libsql/core": "^0.15.15",
		"@lobehub/icons-static-svg": "^1.95.1",
		"@modelcontextprotocol/client": "^2.0.0",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@novnc/novnc": "^1.7.0",
		"@pierre/diffs": "^1.4.2",
		"@pierre/trees": "1.0.0-beta.6",
		"@tanstack/charts": "^1.0.0",
		"@tanstack/react-query": "^5.90.2",
		"@tanstack/react-router": "^1.131.36",
		"@xterm/addon-fit": "^0.10.0",
		"@xterm/xterm": "^5.5.0",
		"aws4fetch": "^1.0.20",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.3.2",
		"croner": "^10.0.1",
		"fflate": "^0.8.3",
