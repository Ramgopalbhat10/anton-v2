{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [
			"ESNext"
		],
		"types": [
			"node"
		],
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"paths": {
			"@/*": ["./src/web/*"]
		}
	},
	"include": [
		"src/app.ts",
		"src/db.ts",
		"src/agents",
		"src/lib",
		"tests"
	]
}
