{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["react"],
	"categories": { "correctness": "off", "suspicious": "off", "perf": "off", "style": "off", "pedantic": "off", "restriction": "off", "nursery": "off" },
	"rules": {
		"react-hooks/rules-of-hooks": "error",
		"react-hooks/exhaustive-deps": "warn"
	}
}
